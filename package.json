{
  "name": "beatlab-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for beatmakers: samples library, tools and collaboration board",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "bun test",
    "web:build": "bun build web/main.ts --outdir web/public",
    "web:serve": "bun src/web/server.ts",
    "up": "bun scripts/up.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "grammy": "^1.36.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/bun": "^1.3.0",
    "audio-decode": "^3.12.0",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.9.3"
  }
}
