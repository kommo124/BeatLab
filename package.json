{
  "name": "beatlab-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for beatmakers: samples library, tools and collaboration board",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "grammy": "^1.36.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.9.3"
  }
}
